{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=22.22.2 <23.0.0",
    "npm": ">=12.0.0 <12.1.0"
  },
  "allowScripts": {
    "esbuild@0.27.3": true
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "node ./scripts/generate-serve-config.mjs --check && tsc --noEmit && vite build && node ./scripts/generate-serve-config.mjs --output ./.generated/serve.json && npm run perf:check",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:a11y": "vitest run src/app/accessibility.routes.test.tsx",
    "test:dependency-audit": "node --test ./scripts/dependency-audit.node.mjs",
    "test:security-headers": "node --test ./scripts/security-headers.node.mjs",
    "e2e:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --workers=1 --retries=0 --reporter=line",
    "perf:check": "node ./scripts/performance-budget.mjs",
    "deps:audit": "node ./scripts/dependency-audit.mjs",
    "openapi:sync": "node ./scripts/sync-openapi.mjs",
    "openapi:check": "node ./scripts/sync-openapi.mjs --check",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:security-headers && npm run test:dependency-audit && npm run openapi:check && npm run deps:audit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.0.18",
    "axe-core": "^4.11.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.1.0",
    "markdownlint-cli": "0.48.0",
    "tailwindcss": "^4.1.18",
    "terser": "^5.46.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "7.3.5",
    "vitest": "^4.0.8"
  }
}
