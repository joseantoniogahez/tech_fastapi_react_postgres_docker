# Template for Docker Compose local configuration.
# Copy this file to .env and customize values for your machine.

# ------------------------------------------------------------
# API SERVICE (FastAPI container + runtime behavior)
# ------------------------------------------------------------
# API_HOST: backend container name/hostname used inside the Docker network.
API_HOST=system_api

# APP_ENV: local, test, development, staging, or production (dev/prod are aliases).
# Unknown values fail validation. Staging/production disable public OpenAPI routes and require JWT_*.
APP_ENV=local

# API_PORT: backend port exposed on host and used by the backend container.
API_PORT=8000

# API_PATH: FastAPI root_path metadata (useful behind a reverse proxy).
# Canonical local contract mounts API routes at root, so keep this empty.
API_PATH=

# API_CORS_ORIGINS: comma-separated bare HTTP(S) browser origins allowed by credentialed CORS.
# Paths, queries, fragments, credentials, wildcards, and trailing slashes are rejected/normalized.
API_CORS_ORIGINS=http://localhost:3000

# LOG_LEVEL: backend logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=WARNING

# READINESS_TIMEOUT_SECONDS: timeout applied to each dependency check (0 < value <= 30).
READINESS_TIMEOUT_SECONDS=2

# READINESS_MAX_CONCURRENCY: maximum simultaneous dependency checks (1..32).
READINESS_MAX_CONCURRENCY=4

# Authentication rate limiting defaults to memory outside Compose in local/test/development.
# Compose selects authenticated Redis on its private network. Staging/production require enabled
# shared Redis plus explicit login/register/window values. Non-Compose Redis must use rediss://
# unless a private transport has an explicit REDIS_ALLOW_PLAINTEXT=true exception.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=memory
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_NAMESPACE=foundation:rate-limit:v1
REDIS_URL=rediss://redis.example:6379/0
REDIS_PASSWORD=REPLACE_ME  # pragma: allowlist secret
REDIS_ALLOW_PLAINTEXT=false
REDIS_TIMEOUT_SECONDS=2

# ------------------------------------------------------------
# AUTH SERVICE (JWT signing and expiration)
# ------------------------------------------------------------
# JWT_SECRET_KEY: JWT signing secret.
# Local/test can use this default. In prod set a strong random secret.
JWT_SECRET_KEY=local-development-jwt-secret-32-bytes  # pragma: allowlist secret

# JWT_ALGORITHM: JWT algorithm.
JWT_ALGORITHM=HS256

# JWT_ACCESS_TOKEN_EXPIRE_MINUTES: access token lifetime in minutes.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT_ISSUER: expected JWT issuer claim.
JWT_ISSUER=fastapi-template

# JWT_AUDIENCE: expected JWT audience claim.
JWT_AUDIENCE=fastapi-template-api

# ------------------------------------------------------------
# DATABASE SERVICE (PostgreSQL connection for backend)
# ------------------------------------------------------------
# DB_HOST: database container hostname in the Docker network.
DB_HOST=system_db

# DB_PORT: PostgreSQL port exposed on host.
DB_PORT=5432

# DB_NAME: PostgreSQL database name.
DB_NAME=main_db

# DB_USER: PostgreSQL username.
DB_USER=my_admin

# DB_PASSWORD: PostgreSQL password (change before first run).
DB_PASSWORD=REPLACE_ME  # pragma: allowlist secret

# DB_TYPE: SQLAlchemy async driver for PostgreSQL.
DB_TYPE=postgresql+asyncpg

# ------------------------------------------------------------
# FRONTEND SERVICE (Vite + React container network/port settings)
# ------------------------------------------------------------
# UI_HOST: frontend container name/hostname used in Docker network.
UI_HOST=system_frontend

# UI_PORT: frontend port exposed on host.
UI_PORT=3000

# VITE_API_ORIGIN: API origin consumed by browser-side frontend code.
# If API_PORT changes, update this value accordingly.
VITE_API_ORIGIN=http://localhost:8000

# VITE_API_BASE_PATH: API base path consumed by browser-side frontend code.
# Canonical contract uses versioned API routes.
VITE_API_BASE_PATH=/v1

# UI_PATH: reserved for proxy/path-based deployments (not consumed directly here).
UI_PATH=/

# ------------------------------------------------------------
# BUILD AND CONTAINER LOGGING (optional tuning)
# ------------------------------------------------------------
# PYTHON_VERSION: Python version used to build the backend image.
PYTHON_VERSION=3.14.6

# BACKEND_LOG_MAX_SIZE: max size per backend container log file.
BACKEND_LOG_MAX_SIZE=10m

# BACKEND_LOG_MAX_FILE: max number of rotated backend log files.
BACKEND_LOG_MAX_FILE=3
